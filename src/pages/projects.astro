---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---
<Base title="Projects">
  <h1>Projects 🛠️</h1>
  <p class="lead">Things I've built, shipped, or tinkered with. More on <a href="https://github.com/Amelia-Wu">GitHub</a>.</p>
  <div class="grid">
    {projects.map((p) => <ProjectCard p={p} />)}
  </div>
</Base>
